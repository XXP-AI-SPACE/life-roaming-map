<view class="page">
  <view class="hd album-hd">
    <view>
      <view class="hd-title">足迹</view>
      <view class="hd-sub" wx:if="{{loaded}}">{{total}} 段记忆，按时间排好</view>
    </view>
    <view class="add-mini" bindtap="goAdd">＋</view>
  </view>

  <block wx:if="{{loaded && total === 0}}">
    <view class="empty">
      <view class="empty-title">还没有记录</view>
      <view class="empty-desc">去地图上点亮第一个省份</view>
      <view class="empty-desc">一张照片，一句话，就够了</view>
      <view class="btn-primary empty-btn" bindtap="goMap">去地图看看</view>
    </view>
  </block>

  <block wx:for="{{groups}}" wx:key="label" wx:for-item="g">
    <view class="month">{{g.label}}</view>
    <view class="list">
      <view
        class="item"
        wx:for="{{g.items}}"
        wx:key="_id"
        wx:for-item="it"
        data-id="{{it._id}}"
        bindtap="goDetail"
      >
        <image class="item-img" src="{{it.fileID}}" mode="aspectFill" lazy-load="true"></image>
        <view class="item-main">
          <view class="item-title">{{it.title}}</view>
          <view class="item-meta">{{it.place}}</view>
          <view class="item-note" wx:if="{{it.note}}">{{it.note}}</view>
          <view class="item-date">{{it.date}}</view>
        </view>
      </view>
    </view>
  </block>

  <view class="tail" wx:if="{{loaded && total > 0}}">— 就记到这里 —</view>
</view>
