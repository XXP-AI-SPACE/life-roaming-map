/* app.wxss —— 全局基底：暖纸色 + 赭石点缀 */
page {
  background: #F7F4EE;
  color: #2C2822;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, input, textarea, button {
  box-sizing: border-box;
}

.hd {
  padding: 20rpx 32rpx 8rpx;
}
.hd-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #2C2822;
}
.hd-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8C8275;
  letter-spacing: 0.5rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 70, 40, 0.06);
}

.muted { color: #9A8F80; }

/* 主按钮 */
.btn-primary {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  background: #A8623A;
  color: #FFF9F2;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}
.btn-primary.is-disabled {
  background: #D9CEC0;
  color: #FFF9F2;
}

/* 空状态 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
}
.empty-title {
  font-size: 30rpx;
  color: #6B5B49;
}
.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #A79C8D;
  line-height: 1.7;
}
